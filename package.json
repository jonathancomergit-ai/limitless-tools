{
  "name": "limitless-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Limitless Workshop: one wing of Limitless Lab. Plain ES modules, no build step.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "serve": "node tests/server.js",
    "new-item": "node scripts/new-item.js",
    "kit:hash": "node scripts/kit-hash.js",
    "sitemap": "node scripts/build-sitemap.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
